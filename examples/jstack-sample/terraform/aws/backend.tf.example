# Copy to backend.tf on a live root. Leave this example out of the test module.
# Give dev, test, and prod different key values. Do not share one object.

terraform {
  backend "s3" {
    bucket       = "example-tfstate"
    key          = "app/dev.tfstate"
    region       = "eu-west-2"
    encrypt      = true
    use_lockfile = true
  }
}
